# Copy to .env and adjust. Every value is optional.

PORT=3001
HOST=0.0.0.0
DATA_DIR=./server/data

# Set to the number of reverse proxies in front of Texflow (for example 1 behind nginx or Caddy).
# This makes cookies "Secure" over HTTPS and rate limits use the real client address.
TRUST_PROXY=0

# Set to false after creating your account to close sign-ups on a private instance.
ALLOW_REGISTRATION=true
SESSION_DAYS=30

# Per-user and per-project limits
MAX_PROJECTS_PER_USER=40
MAX_FILES_PER_PROJECT=80
MAX_TEXT_FILE_BYTES=1048576
MAX_UPLOAD_BYTES=8388608
MAX_PROJECT_BYTES=33554432

# Compilation
COMPILE_TIMEOUT_MS=45000
COMPILE_CONCURRENCY=2
COMPILE_QUEUE_LIMIT=12
ALLOW_LUALATEX=false
